rules_version = '2';
// One Firestore for every app. Shared: accounts, usernames. Per app: pantry_*, whyb_*, movi_*.
// Anything not matched below is denied. Collections written only by Cloud Functions
// (ai_usage, movi_notifications creation, movi_film_stats, movi_stats) have no client write rule.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isMe(uid) { return request.auth != null && request.auth.uid == uid; }
    function doc(coll, id) { return /databases/$(database)/documents/$(coll)/$(id); }
    function validUsername(name) { return name is string && name.matches('^[a-z0-9_.]{3,20}$'); }
    function text(v, max) { return v is string && v.size() <= max; }
    function changedOnly(fields) { return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields); }
    function createdAtKept() {
      return resource == null ? request.resource.data.createdAt == request.time
                              : request.resource.data.createdAt == resource.data.createdAt;
    }

    // ───────────────────────── Shared account ─────────────────────────
    // accounts/{uid}: the one username and display name a person has across every app.
    // usernames/{name}: who owns a name. Both are written together in one batch, so a name
    // can never have two owners and a person can never hold two names.
    function accountName(uid) { return getAfter(doc('accounts', uid)).data.username; }
    function appProfileFollows(coll, uid, name) {
      return !existsAfter(doc(coll, uid)) || getAfter(doc(coll, uid)).data.username == name;
    }

    match /accounts/{uid} {
      allow read: if signedIn();
      allow create, update: if isMe(uid)
        && request.resource.data.keys().hasOnly(['username', 'displayName', 'createdAt', 'updatedAt'])
        && request.resource.data.keys().hasAll(['username', 'displayName', 'createdAt', 'updatedAt'])
        && validUsername(request.resource.data.username)
        && text(request.resource.data.displayName, 40)
        && createdAtKept()
        && request.resource.data.updatedAt == request.time
        && getAfter(doc('usernames', request.resource.data.username)).data.uid == uid
        && appProfileFollows('movi_profiles', uid, request.resource.data.username)
        && appProfileFollows('whyb_profiles', uid, request.resource.data.username);
    }

    match /usernames/{name} {
      allow read: if signedIn();
      allow create: if signedIn()
        && validUsername(name)
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid
        && accountName(request.auth.uid) == name;
      // a name is released only in the same batch that moves its owner to another name
      allow delete: if signedIn()
        && resource.data.uid == request.auth.uid
        && accountName(request.auth.uid) != name;
    }

    // ───────────────────────── The Pantry ─────────────────────────
    match /pantry_users/{uid} {
      allow read, delete: if isMe(uid);
      allow create, update: if isMe(uid)
        && request.resource.data.keys().hasOnly(['pantry', 'updatedAt'])
        && request.resource.data.pantry is list
        && request.resource.data.pantry.size() <= 200
        && request.resource.data.updatedAt == request.time;

      match /recipes/{recipeId} {
        allow read, delete: if isMe(uid);
        allow create, update: if isMe(uid)
          && request.resource.data.keys().hasOnly(['recipe', 'request', 'createdAt'])
          && request.resource.data.recipe is map
          && text(request.resource.data.recipe.title, 200)
          && (request.resource.data.request == null || request.resource.data.request is map)
          && request.resource.data.createdAt is timestamp;
      }
    }

    // ───────────────────────── Where Have You Been ─────────────────────────
    // Private logbook (notes, dates, home base). Only its owner.
    match /whyb_users/{uid} {
      allow read, delete: if isMe(uid);
      allow create, update: if isMe(uid)
        && request.resource.data.keys().hasOnly(['book', 'settings', 'name', 'updatedAt'])
        && text(request.resource.data.book, 950000)
        && text(request.resource.data.settings, 20000)
        && text(request.resource.data.name, 200)
        && request.resource.data.updatedAt == request.time;
    }

    // Friends-only profile: username, stats and visited places.
    match /whyb_profiles/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || request.auth.uid in resource.data.friends);

      allow create, update: if isMe(uid)
        && request.resource.data.keys().hasOnly(['username', 'name', 'stats', 'visited', 'friends', 'updatedAt'])
        && request.resource.data.friends is list
        && request.resource.data.friends.size() <= 500
        && request.resource.data.username == accountName(uid)
        && (!('name' in request.resource.data) || text(request.resource.data.name, 40))
        && (!('stats' in request.resource.data) || request.resource.data.stats is map)
        && (!('visited' in request.resource.data) || request.resource.data.visited is map);

      // Someone else may only add or remove THEMSELVES in your friends list:
      //  - add: only when you sent them a friend request (they are accepting it)
      //  - remove: always (unfriending)
      allow update: if signedIn() && request.auth.uid != uid
        && changedOnly(['friends'])
        && (
          (request.resource.data.friends.toSet() == resource.data.friends.toSet().union([request.auth.uid].toSet())
            && exists(doc('whyb_requests', request.auth.uid + '_' + uid)))
          ||
          request.resource.data.friends.toSet() == resource.data.friends.toSet().difference([request.auth.uid].toSet())
        );
      allow delete: if isMe(uid);
    }

    // Friend requests, id = "<to>_<from>". Visible to both people; either can delete.
    match /whyb_requests/{id} {
      allow read: if signedIn() && (resource.data.to == request.auth.uid || resource.data.from == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.from == request.auth.uid
        && request.resource.data.to is string
        && request.resource.data.to != request.auth.uid
        && id == request.resource.data.to + '_' + request.auth.uid
        && request.resource.data.keys().hasOnly(['from', 'to', 'fromName', 'toName', 'createdAt'])
        && text(request.resource.data.fromName, 20) && text(request.resource.data.toName, 20)
        && request.resource.data.fromName == accountName(request.auth.uid)
        && request.resource.data.createdAt == request.time;
      allow delete: if signedIn() && (resource.data.to == request.auth.uid || resource.data.from == request.auth.uid);
    }

    // ───────────────────────── Movi ─────────────────────────
    // Every Movi account is public to signed-in members. Private to the owner: backlog,
    // notifications, and recommendations (sender and receiver only).
    function moviBucket(b) { return b in ['loved', 'fine', 'disliked']; }
    function filmId(v) { return v is int && v >= 0 && v < 10000000; }
    function listTotalAfter(uid) {
      return existsAfter(doc('movi_lists', uid))
        ? getAfter(doc('movi_lists', uid)).data.loved.size()
          + getAfter(doc('movi_lists', uid)).data.fine.size()
          + getAfter(doc('movi_lists', uid)).data.disliked.size()
        : 0;
    }

    match /movi_profiles/{uid} {
      allow read: if signedIn();
      allow create, update: if isMe(uid)
        && request.resource.data.keys().hasOnly(['username', 'displayName', 'nameLower', 'bio', 'avatarHue', 'yearlyGoal', 'rankedCount', 'createdAt'])
        && request.resource.data.keys().hasAll(['username', 'displayName', 'nameLower', 'bio', 'avatarHue', 'yearlyGoal', 'rankedCount', 'createdAt'])
        && request.resource.data.username == accountName(uid)
        && text(request.resource.data.displayName, 40)
        && request.resource.data.nameLower == request.resource.data.displayName.lower()
        && text(request.resource.data.bio, 160)
        && request.resource.data.avatarHue is int && request.resource.data.avatarHue >= 0 && request.resource.data.avatarHue <= 359
        && request.resource.data.yearlyGoal is int && request.resource.data.yearlyGoal >= 1 && request.resource.data.yearlyGoal <= 1000
        && request.resource.data.rankedCount == listTotalAfter(uid)
        && createdAtKept();
    }

    // The three ranked lists, best first. Scores are worked out from position, so this one
    // document is the whole ranking. `at` maps film id -> when it was first ranked (ms).
    match /movi_lists/{uid} {
      allow read: if signedIn();
      allow create, update: if isMe(uid)
        && request.resource.data.keys().hasOnly(['loved', 'fine', 'disliked', 'at', 'updatedAt'])
        && request.resource.data.keys().hasAll(['loved', 'fine', 'disliked', 'at', 'updatedAt'])
        && request.resource.data.loved is list
        && request.resource.data.fine is list
        && request.resource.data.disliked is list
        && request.resource.data.at is map
        && request.resource.data.updatedAt == request.time
        && listTotalAfter(uid) <= 20000
        // a film appears once across all three lists
        && request.resource.data.loved.concat(request.resource.data.fine).concat(request.resource.data.disliked).toSet().size() == listTotalAfter(uid)
        && getAfter(doc('movi_profiles', uid)).data.rankedCount == listTotalAfter(uid);
    }

    // Watch details and notes for one ranked film. id = "<uid>_<filmId>".
    match /movi_entries/{id} {
      allow read: if signedIn();
      allow create, update: if isMe(request.resource.data.uid)
        && filmId(request.resource.data.filmId)
        && id == request.auth.uid + '_' + string(request.resource.data.filmId)
        && request.resource.data.keys().hasOnly(['uid', 'filmId', 'note', 'watchedOn', 'watchedWhere', 'watchedWith', 'rewatch', 'updatedAt'])
        && text(request.resource.data.note, 2000)
        && (request.resource.data.watchedOn == null || (request.resource.data.watchedOn is string && request.resource.data.watchedOn.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')))
        && text(request.resource.data.watchedWhere, 40)
        && text(request.resource.data.watchedWith, 120)
        && request.resource.data.rewatch is bool
        && request.resource.data.updatedAt == request.time;
      allow delete: if isMe(resource.data.uid);
    }

    // Want to watch. items: filmId -> { at: ms, from: uid | null }
    match /movi_watchlists/{uid} {
      allow read: if signedIn();
      allow create, update: if isMe(uid)
        && request.resource.data.keys().hasOnly(['items', 'updatedAt'])
        && request.resource.data.items is map
        && request.resource.data.items.size() <= 5000
        && request.resource.data.updatedAt == request.time;
      allow delete: if isMe(uid);
    }

    // To rank (private). items: filmId -> ms
    match /movi_backlogs/{uid} {
      allow read, delete: if isMe(uid);
      allow create, update: if isMe(uid)
        && request.resource.data.keys().hasOnly(['items', 'updatedAt'])
        && request.resource.data.items is map
        && request.resource.data.items.size() <= 5000
        && request.resource.data.updatedAt == request.time;
    }

    // id = "<follower>_<followee>"
    match /movi_follows/{id} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['follower', 'followee', 'createdAt'])
        && request.resource.data.follower == request.auth.uid
        && request.resource.data.followee is string
        && request.resource.data.followee != request.auth.uid
        && id == request.auth.uid + '_' + request.resource.data.followee
        && exists(doc('movi_profiles', request.resource.data.followee))
        && request.resource.data.createdAt == request.time;
      allow delete: if signedIn() && (resource.data.follower == request.auth.uid || resource.data.followee == request.auth.uid);
    }

    match /movi_activities/{id} {
      allow read: if signedIn();
      allow create: if isMe(request.resource.data.uid)
        && request.resource.data.keys().hasOnly(['uid', 'kind', 'filmId', 'bucket', 'score', 'note', 'createdAt', 'likeCount', 'commentCount'])
        && request.resource.data.kind in ['ranked', 'want']
        && filmId(request.resource.data.filmId)
        && (request.resource.data.bucket == null || moviBucket(request.resource.data.bucket))
        && (request.resource.data.score == null || (request.resource.data.score is number && request.resource.data.score >= 0 && request.resource.data.score <= 10))
        && text(request.resource.data.note, 2000)
        && request.resource.data.createdAt == request.time
        && request.resource.data.likeCount == 0
        && request.resource.data.commentCount == 0;
      allow update: if isMe(resource.data.uid)
        && changedOnly(['note', 'score', 'bucket'])
        && (request.resource.data.bucket == null || moviBucket(request.resource.data.bucket))
        && (request.resource.data.score == null || (request.resource.data.score is number && request.resource.data.score >= 0 && request.resource.data.score <= 10))
        && text(request.resource.data.note, 2000);
      allow delete: if isMe(resource.data.uid);
    }

    // id = "<activityId>_<uid>"
    match /movi_likes/{id} {
      allow read: if signedIn();
      allow create: if isMe(request.resource.data.uid)
        && request.resource.data.keys().hasOnly(['activityId', 'uid', 'createdAt'])
        && request.resource.data.activityId is string
        && id == request.resource.data.activityId + '_' + request.auth.uid
        && exists(doc('movi_activities', request.resource.data.activityId))
        && request.resource.data.createdAt == request.time;
      allow delete: if isMe(resource.data.uid);
    }

    match /movi_comments/{id} {
      allow read: if signedIn();
      allow create: if isMe(request.resource.data.uid)
        && request.resource.data.keys().hasOnly(['activityId', 'uid', 'body', 'createdAt'])
        && request.resource.data.activityId is string
        && request.resource.data.body is string
        && request.resource.data.body.size() >= 1 && request.resource.data.body.size() <= 500
        && exists(doc('movi_activities', request.resource.data.activityId))
        && request.resource.data.createdAt == request.time;
      allow delete: if signedIn() && (resource.data.uid == request.auth.uid
        || get(doc('movi_activities', resource.data.activityId)).data.uid == request.auth.uid);
    }

    match /movi_recs/{id} {
      allow read: if signedIn() && (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['from', 'to', 'filmId', 'message', 'createdAt'])
        && request.resource.data.from == request.auth.uid
        && request.resource.data.to is string
        && request.resource.data.to != request.auth.uid
        && exists(doc('movi_profiles', request.resource.data.to))
        && filmId(request.resource.data.filmId)
        && text(request.resource.data.message, 280)
        && request.resource.data.createdAt == request.time;
      allow delete: if signedIn() && (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);
    }

    // Written by Cloud Functions. The owner can mark them read or clear them.
    match /movi_notifications/{id} {
      allow read, delete: if signedIn() && resource.data.uid == request.auth.uid;
      allow update: if signedIn() && resource.data.uid == request.auth.uid
        && changedOnly(['read']) && request.resource.data.read is bool;
    }

    // Site-wide averages, rebuilt by a scheduled Cloud Function.
    match /movi_film_stats/{chunk} { allow read: if signedIn(); }
    match /movi_stats/{id} { allow read: if signedIn(); }
  }
}
